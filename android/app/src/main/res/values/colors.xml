<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 战斗模拟器主题色：与 web/styles.css 的 token 对齐。
         ⚠️ XML 注释里不能出现连续两个减号（CSS 变量名要改写，否则资源编译报错）。 -->
    <!-- 绯红 · CSS 变量 red -->
    <color name="colorPrimary">#8F2C2C</color>
    <!-- 深褐 · CSS 变量 bg：同时作为窗口底色，消除系统栏 / 挖孔区露白 -->
    <color name="colorPrimaryDark">#12100F</color>
    <!-- 鎏金 · CSS 变量 gold -->
    <color name="colorAccent">#C49A36</color>
    <color name="splashBackground">#12100F</color>
</resources>
